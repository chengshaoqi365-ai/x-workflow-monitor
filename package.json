{
  "name": "@local/x-workflow-monitor",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "description": "DSH plugin that shows the X automation run detail and to-do queue, with start, dry-run and stop through the local control service.",
  "keywords": [
    "dsh-plugin",
    "x-automation",
    "workflow-monitor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengshaoqi365-ai/x-workflow-monitor.git"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --experimental-test-module-mocks --test scripts/test-service-start.mjs"
  }
}
